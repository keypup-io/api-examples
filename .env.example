# Copy to .env and fill in. .env is git-ignored; this file is not.

# Your Keypup API token: Settings > Account > API Tokens, with the
# "Reporting API" scope. See README.md.
KEYPUP_API_TOKEN=
# Your team's ID: in the variables of any query the API Explorer opens.
KEYPUP_COMPANY_ID=

# slack-stale-pull-requests: the bot token of your Slack app (xoxb-...) and
# the channel to post to. See slack-stale-pull-requests/README.md.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#engineering
